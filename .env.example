# =========================================================
# AI Resume Intelligence & ATS Optimization Platform
# Environment configuration template.
# Copy to .env and fill in real values. Never commit .env.
# =========================================================

# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (used starting Phase 2) ---
DATABASE_URL=

# --- Milvus vector database (used starting Phase 5) ---
MILVUS_HOST=
MILVUS_PORT=

# --- Redis cache / background processing (used starting Phase 8) ---
REDIS_URL=

# --- Auth (used starting Phase 2) ---
JWT_SECRET=

# --- LLM provider (used starting Phase 7) ---
LLM_API_KEY=

# --- Frontend (see frontend/.env.example) ---
# VITE_API_BASE_URL=http://localhost:8000