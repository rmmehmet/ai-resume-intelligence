# =========================================================
# AI Resume Intelligence & ATS Optimization Platform
# Environment configuration template.
# Copy to .env and fill in real values. Never commit .env.
# =========================================================

# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (used starting Phase 2) ---
# Example: postgresql://user:password@localhost:5432/resume_ats
# Defaults to a local SQLite file if left empty, for easy local dev.
DATABASE_URL=

# --- Milvus vector database (used starting Phase 5) ---
# Preferred: MILVUS_URI (works for both Zilliz Cloud and self-hosted).
# Not required for matching to work - resume/job embeddings are stored
# directly on their rows and compared without Milvus. Milvus becomes
# useful once large-scale search across many resumes/jobs is needed.
# Zilliz Cloud (recommended for local dev on Windows - no Docker needed):
#   MILVUS_URI=https://<your-cluster>.zillizcloud.com
#   MILVUS_TOKEN=<your api key>
# Self-hosted (e.g. via docker-compose in production):
#   MILVUS_HOST=localhost
#   MILVUS_PORT=19530
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_HOST=
MILVUS_PORT=

# --- Embeddings (used starting Phase 5) ---
# "sentence-bert": real semantic embeddings (recommended). Downloads
# the model (~90MB) from Hugging Face automatically on first use -
# requires outbound internet access the first time it runs.
# "tfidf": lightweight fallback, no model download, weaker semantics.
EMBEDDING_PROVIDER=sentence-bert
EMBEDDING_MODEL_NAME=

# --- Redis cache / background processing (used starting Phase 8) ---
REDIS_URL=

# --- Auth (used starting Phase 2) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM provider (used starting Phase 7) ---
LLM_API_KEY=

# --- File storage (used starting Phase 3) ---
# Local disk path for now; will move to S3/GCS before production.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Frontend (see frontend/.env.example) ---
# VITE_API_BASE_URL=http://localhost:8000